# --- Block 2: mirage helper namespace in image_data_buffer.cc -----------------
# Bit-exact C++ port of inject/rng.js (lines: mulberry32 / hash32 / INT_SALT)
# plus the canvasSeed scanner and the noise application. Must stay identical
# to the copy inserted by block 5 (ODR, see the patch header).

MIRAGE-BLOCK
MIRAGE-FILE: third_party/blink/renderer/platform/graphics/image_data_buffer.cc
MIRAGE-SIGNATURE: ^namespace blink \{
MIRAGE-REPLACE-FROM:
namespace blink {
MIRAGE-REPLACE-TO:
namespace blink {
// <<<MIRAGE(canvas-serialization-noise)
// Deterministic serialization noise for canvas encoders, seeded from the
// "canvasSeed" field of MIRAGE_FP_CONFIG (see patches/README.md).
//
// The per-pixel decisions are a bit-exact C++ port of inject/rng.js and the
// getImageData noise in inject/canvas.js: for pixel (x, y), flip the LSB of
// channel MirageInt(seed, x, y, 4) when MirageNoise(seed, x, y) < 0.03.
// Because the JS layer keys its noise on the same (canvasSeed, x, y) in
// absolute canvas coordinates, a PNG decoded from toDataURL matches a
// getImageData(0, 0, w, h) read of the same canvas — the "same noised
// pixel path" required by inject/README.md. Stable per profile, different
// across profiles, invisible to the eye.
namespace mirage {

// ---- port of inject/rng.js (bit-exact; all arithmetic is 32-bit) ----

inline uint32_t MirageHash32(uint32_t a, uint32_t b, uint32_t c) {
  uint32_t h = a ^ 0x9E3779B9u;
  h ^= h << 13;
  h ^= h >> 17;
  h ^= h << 5;
  h ^= b;
  h *= 0x85EBCA6Bu;
  h ^= h >> 13;
  h *= 0xC2B2AE35u;
  h ^= h >> 16;
  h ^= c;
  h *= 0x27D4EB2Fu;
  h ^= h >> 15;
  h *= 0x165667B1u;
  h ^= h >> 13;
  return h;
}

inline double MirageMulberry32(uint32_t a) {
  a += 0x6D2B79F5u;
  uint32_t t = (a ^ (a >> 15)) * (a | 1u);
  t = (t + ((t ^ (t >> 7)) * (t | 61u))) ^ t;
  return static_cast<double>(t ^ (t >> 14)) / 4294967296.0;
}

// inject/rng.js: noise(seed, x, y)
inline double MirageNoise(uint32_t seed, int x, int y) {
  return MirageMulberry32(
      MirageHash32(seed, static_cast<uint32_t>(x), static_cast<uint32_t>(y)));
}

// inject/rng.js: int(seed, x, y, max) — different hash salt on purpose, so
// the flip decision and the channel pick are decorrelated.
inline int MirageInt(uint32_t seed, int x, int y, int max) {
  const double v = MirageMulberry32(MirageHash32(
      seed ^ 0x5BD1E995u, static_cast<uint32_t>(x), static_cast<uint32_t>(y)));
  return static_cast<int>(v * max);
}

// ---- "canvasSeed" from MIRAGE_FP_CONFIG (0 = inactive / missing) ----

inline uint32_t CanvasSeed() {
  static const uint32_t seed = []() -> uint32_t {
    const char* config_path = std::getenv("MIRAGE_FP_CONFIG");
    if (config_path == nullptr || *config_path == '\0') {
      return 0;
    }
    std::FILE* const file = std::fopen(config_path, "rb");
    if (file == nullptr) {
      return 0;
    }
    std::string json;
    char buffer[4096];
    size_t read;
    while ((read = std::fread(buffer, 1, sizeof(buffer), file)) > 0) {
      json.append(buffer, read);
    }
    std::fclose(file);
    const std::string key = "\"canvasSeed\"";
    const size_t pos = json.find(key);
    if (pos == std::string::npos) {
      return 0;
    }
    const size_t colon = json.find(':', pos + key.size());
    if (colon == std::string::npos) {
      return 0;
    }
    size_t i = colon + 1;
    while (i < json.size() &&
           (json[i] == ' ' || json[i] == '\t' || json[i] == '\n' ||
            json[i] == '\r')) {
      ++i;
    }
    if (i < json.size() && json[i] == '-') {
      return 0;  // contract stores canvasSeed as u32; negatives are invalid
    }
    uint64_t value = 0;
    while (i < json.size() && json[i] >= '0' && json[i] <= '9') {
      value = value * 10 + static_cast<uint64_t>(json[i] - '0');
      ++i;
    }
    return static_cast<uint32_t>(value & 0xFFFFFFFFull);
  }();
  return seed;
}

// ---- the noise itself ----

// Applies the same per-pixel decisions as the JS getImageData noise to the
// 4-bytes-per-pixel buffer that feeds a canvas image encoder. `bgra` must
// be true when the buffer stores BGRA byte order (kN32 on Windows) so the
// flipped byte lands on the same *named* channel (R/G/B/A) the JS layer
// flips in ImageData.data (always RGBA). Call this on the encoder input,
// after any copy/unpremultiply step, exactly once per encoding.
inline void ApplyCanvasSerializationNoise(uint8_t* pixels,
                                          int width,
                                          int height,
                                          bool bgra) {
  const uint32_t seed = CanvasSeed();
  if (seed == 0 || pixels == nullptr || width <= 0 || height <= 0) {
    return;
  }
  const double kRate = 0.03;  // must match RATE in inject/canvas.js
  for (int y = 0; y < height; ++y) {
    uint8_t* const row =
        pixels + static_cast<size_t>(y) * static_cast<size_t>(width) * 4u;
    for (int x = 0; x < width; ++x) {
      if (MirageNoise(seed, x, y) < kRate) {
        const int channel = MirageInt(seed, x, y, 4);
        int offset = channel;
        if (bgra && channel < 3) {
          offset = 2 - channel;  // R <-> B swap; alpha index 3 unchanged
        }
        row[x * 4 + offset] ^= 1u;
      }
    }
  }
}

}  // namespace mirage
// >>>MIRAGE(canvas-serialization-noise)
MIRAGE-ENDBLOCK

