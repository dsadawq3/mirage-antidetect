                                  std::optional<float> quality) const {
MIRAGE-REPLACE-TO:
String ImageDataBuffer::ToDataURL(const String& mime_type,
                                  std::optional<float> quality) const {
  // <<<MIRAGE(canvas-serialization-noise)
  // Deterministic per-profile noise over the pixel copy that feeds the
  // image encoder — serialization only: getImageData and canvas rendering
  // are untouched. Runs after the copy/unpremultiply that produced this
  // buffer, so the encoded PNG/JPEG/WebP bytes themselves carry the noise
  // while staying perfectly valid.
  if (mirage::CanvasSeed() != 0) {
    SkPixmap pixmap = Pixmap();
    if (void* const pixels = pixmap.writable_addr()) {
      const bool bgra = pixmap.info().colorType() == kBGRA_8888_SkColorType;
      mirage::ApplyCanvasSerializationNoise(
          reinterpret_cast<uint8_t*>(pixels), pixmap.width(), pixmap.height(),
          bgra);
    }
  }
  // >>>MIRAGE(canvas-serialization-noise)
