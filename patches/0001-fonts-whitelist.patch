namespace blink {
// <<<MIRAGE(fonts-whitelist)
// Font whitelist from MIRAGE_FP_CONFIG (see patches/README.md). The env var
// points at a file with the same JSON the JS layer receives as
// window.__MIRAGE_FP__; only the "fonts" array is consumed here. Inert
// without the variable: stock font resolution, byte for byte.
namespace mirage {

// True when a Mirage profile is active.
inline bool ProfileActive() {
  static const bool active = [] {
    const char* config_path = std::getenv("MIRAGE_FP_CONFIG");
    return config_path != nullptr && *config_path != '\0';
  }();
  return active;
}

// The profile's "fonts" array, lowercased. Empty when inactive or unreadable
// — in that state nothing is blocked. Minimal scanner by design: the
// launcher emits canonical JSON and Blink must not grow a JSON dependency
// for this.
inline const std::unordered_set<std::string>& FontWhitelist() {
  static const std::unordered_set<std::string>* const whitelist = [] {
    auto* const set = new std::unordered_set<std::string>();
    const char* config_path = std::getenv("MIRAGE_FP_CONFIG");
    if (config_path == nullptr || *config_path == '\0') {
      return set;
    }
    std::FILE* const file = std::fopen(config_path, "rb");
    if (file == nullptr) {
      return set;
    }
    std::string json;
    char buffer[4096];
    size_t read;
    while ((read = std::fread(buffer, 1, sizeof(buffer), file)) > 0) {
      json.append(buffer, read);
    }
    std::fclose(file);

    // Locate "fonts" : [ ... ] and collect the string elements.
    const size_t key = json.find("\"fonts\"");
    if (key == std::string::npos) {
      return set;
    }
    const size_t open = json.find('[', key);
    if (open == std::string::npos) {
      return set;
    }
    size_t pos = open + 1;
    while (pos < json.size()) {
      const char c = json[pos];
      if (c == ']') {
        break;
      }
      if (c == '"') {
        std::string name;
        ++pos;
        while (pos < json.size() && json[pos] != '"') {
          if (json[pos] == '\\' && pos + 1 < json.size()) {
            ++pos;  // keep the escaped character verbatim
          }
          name.push_back(json[pos]);
          ++pos;
        }
        if (pos < json.size()) {
          ++pos;  // closing quote
        }
        for (char& ch : name) {
          ch = static_cast<char>(::tolower(static_cast<unsigned char>(ch)));
        }
        if (!name.empty()) {
          set->insert(name);
        }
      } else {
        ++pos;
      }
    }
    return set;
  }();
  return *whitelist;
}

// Families that must always resolve, regardless of the whitelist: CSS
// generic keywords (they can reach the font cache verbatim from
// font-family lists) and Blink's own default standard/fixed fonts.
// Blocking those would break rendering instead of hiding a signal.
inline bool IsAlwaysAllowedFontFamily(const std::string& lower_family) {
  static const std::unordered_set<std::string> kAlwaysAllowed = {
      "serif",        "sans-serif",    "monospace",     "cursive",
      "fantasy",      "system-ui",     "ui-serif",      "ui-sans-serif",
      "ui-monospace", "ui-rounded",    "math",          "emoji",
      "fangsong",     "inherit",       "initial",
      // Blink default standard/fixed fonts on Windows.
      // MIRAGE-VERIFY: cross-check the defaults for this tag in
      // third_party/blink/renderer/platform/fonts/win/font_cache_win.cc
      // and content/public/common/web_preferences.h.
      "times new roman", "courier new", "segoe ui",
      "tahoma", "microsoft sans serif", "lucida sans unicode",
  };
  if (lower_family.empty()) {
    return true;
  }
  return kAlwaysAllowed.count(lower_family) != 0;
}

// Gate for FontCache::GetFontData: true when the family must behave exactly
// like a font that is not installed on this machine.
inline bool FontFamilyBlocked(const WTF::AtomicString& family) {
  if (!ProfileActive()) {
    return false;
  }
  const std::string lower = WTF::String(family).LowerASCII().Utf8();
  if (IsAlwaysAllowedFontFamily(lower)) {
    return false;
  }
  const std::unordered_set<std::string>& whitelist = FontWhitelist();
  if (whitelist.empty()) {
    return false;  // profile carries no font data: gate stays off
  }
  return whitelist.count(lower) == 0;
}

}  // namespace mirage
// >>>MIRAGE(fonts-whitelist)
MIRAGE-ENDBLOCK

